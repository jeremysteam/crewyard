PORT=4322
DATA_FILE=.data/board.json
# For a hosted server only, set DATABASE_URL in Render's private environment.
# Never put a real connection string in this file or Git.
# Optional: CrewYard-only Google web client ID. Never use AICreatorU's client ID.
# GOOGLE_CLIENT_ID=

# SaaS runtime: apply saas-runtime-migration.sql manually first.
# First deploy this code with both flags off. After every server is updated,
# enable the flags in a second deployment. Never enable granular writes
# while an older full-snapshot server is still running.
CREWYARD_SHARED_RUNTIME=0
CREWYARD_FINE_GRAINED_WRITES=0
CREWYARD_DB_POOL_SIZE=6
CREWYARD_ACTOR_RPM=240
CREWYARD_WORKSPACE_RPM=2400
CREWYARD_ACTOR_WRITE_RPM=30
CREWYARD_WORKSPACE_WRITE_RPM=120
CREWYARD_WORKSPACE_DAILY_RESPONSE_BYTES=1073741824
CREWYARD_PLATFORM_DAILY_RESPONSE_BYTES=5368709120
